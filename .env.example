# PostgreSQL Configuration
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_DB=ecommerce

# Database URLs (for services)
AUTH_DATABASE_URL=postgresql+asyncpg://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_auth
PRODUCT_DATABASE_URL=postgresql+asyncpg://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_products
ORDER_DATABASE_URL=postgresql+asyncpg://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_orders
PAYMENT_DATABASE_URL=postgresql+asyncpg://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_payments

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Auth Service Configuration
AUTH_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
AUTH_ADMIN_EMAIL=admin@ecommerce.com
AUTH_ADMIN_PASSWORD=admin123

# Service URLs (for inter-service communication)
PRODUCT_SERVICE_URL=http://product-service:8002
AUTH_SERVICE_URL=http://auth-service:8001

# Payment Service Configuration
PAYMENT_MOCK_SUCCESS_RATE=0.8
